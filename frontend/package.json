{
  "name": "budget-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:mobile": "node scripts/prepare-www.mjs",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:assets": "npx @capacitor/assets generate --iconBackgroundColor \"#2ec4b6\" --iconBackgroundColorDark \"#24a195\" --splashBackgroundColor \"#f4f6f9\"",
    "mobile:prepare": "npm run cap:assets && npm run cap:sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
